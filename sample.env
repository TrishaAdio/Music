API_ID= 
API_HASH=
BOT_TOKEN=
MONGO_DB_URI=
LOGGER_ID=-
OWNER_ID=
STRING_SESSION=

# ---------------------------------------------------------------------------
# fastdl (audio engine) - ALL OPTIONAL
# ---------------------------------------------------------------------------
# No cookies, no API keys and no accounts are needed. Leave this section empty
# unless you want to change the defaults.
#
# Source order. Drop "ytdlp" entirely if you never want a cookie prompt.
#FASTDL_PROVIDERS=saavn,soundcloud,innertube,custom,ytdlp
#
# Stream directly to the voice chat (fast start) instead of downloading first.
#FASTDL_DIRECT_STREAM=true
#
# Match confidence floor. Raise if a wrong remix/cover ever plays.
#FASTDL_MIN_MATCH_SCORE=62
#
# Your own resolver endpoint(s). Supports {id} and {query}.
#FASTDL_CUSTOM_API=https://my-api.example/download?id={id}
#
# Bounded on-disk cache size in MB.
#FASTDL_CACHE_MAX_MB=3072
